    {
      "type": "bargauge",
      "title": "Filesystem usage",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "/mnt/nas/core is the md0 mirror holding local-path-core volumes; /mnt/nas/bulk holds media and downloads; /var holds container images and k3s's own default local-path volumes.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "100 * (1 - max by (mountpoint) (node_filesystem_avail_bytes{job=\"node-exporter\", fstype=~\"ext4|xfs|btrfs|zfs\"}) / max by (mountpoint) (node_filesystem_size_bytes{job=\"node-exporter\", fstype=~\"ext4|xfs|btrfs|zfs\"}))",
          "refId": "A",
          "legendFormat": "{{mountpoint}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24,
