    {
      "type": "table",
      "title": "Restarted in the last 24h",
      "description": "Last exit is why the container last stopped. Unknown usually means the host or k3s restarted underneath it; OOMKilled means the memory limit was hit.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "round(sum by (namespace, pod, container) (increase(kube_pod_container_status_restarts_total[24h]))) > 0",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (namespace, pod, container, reason) (kube_pod_container_status_last_terminated_reason == 1) and on (namespace, pod, container) (increase(kube_pod_container_status_restarts_total[24h]) > 0)",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
